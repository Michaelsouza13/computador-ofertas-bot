# ─── Obrigatórios (pelo menos um canal) ───
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=@seu_canal_ofertas

# ─── WhatsApp (opcional, via zap-api) ───
ZAP_API_URL=https://api.zap-api.com
ZAP_API_KEY=sua_chave_aqui
WHATSAPP_PHONE=5511999999999

# ─── Shopee (opcional, sem isso só busca ML e outras lojas) ───
SHOPEE_APP_ID=seu_app_id
SHOPEE_APP_SECRET=seu_app_secret

# ─── Links de Afiliado (opcional) ───
AFFILIATE_TAG_ML=sua_tag_mercado_livre
AFFILIATE_TAG_AMAZON=sua_tag_amazon-20

# ─── Supabase (opcional, para histórico de preços) ───
SUPABASE_URL=https://seu_projeto.supabase.co
SUPABASE_KEY=sua_chave_supabase

# ─── Limites ───
MAX_OFFERS_PER_RUN=15
SEND_DELAY_SECONDS=30
